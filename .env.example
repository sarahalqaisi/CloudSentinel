APP_NAME=CloudSentinel
APP_ENV=development
SECRET_KEY=change-this-before-production
DATABASE_URL=
MAX_UPLOAD_BYTES=12582912
MAX_ARCHIVE_MEMBERS=250
MAX_ARCHIVE_BYTES=33554432
MAX_ARCHIVE_RATIO=100
# Risk component weights are normalized at runtime; values must be non-negative.
RISK_SEVERITY_WEIGHT=0.50
RISK_EXPOSURE_WEIGHT=0.20
RISK_CONFIDENCE_WEIGHT=0.10
RISK_BLAST_RADIUS_WEIGHT=0.10
RISK_EXPLOITABILITY_WEIGHT=0.10
